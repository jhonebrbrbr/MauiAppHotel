<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContatacaoHospedagem"
             Title="ContatacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray200}">

    <VerticalStackLayout VerticalOptions="Center" 
                         HorizontalOptions="Center" Padding="10">

        <Button Text="Sobre" x:Name="btn_sobre" Clicked="btn_sobre_Clicked" 
                        Margin="6" Padding="10"
                        BackgroundColor="{StaticResource Tertiary}" HorizontalOptions="Start"/>

        <Label 
            Text="Cáulculo da diária"
            FontFamily="CookieRegular" 
            FontSize="50"
            TextColor="{StaticResource Black}"/>

        <Border BackgroundColor="{StaticResource Secondary}" Padding="10">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*,*,2*">
                    <Label Grid.Row="0" Grid.Column="0" Text="Adultos: "/>
                    <Label Grid.Row="0" Grid.Column="1" TextColor="{StaticResource Black}" 
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Label Grid.Row="1" Grid.Column="1" TextColor="{StaticResource Black}" 
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>


                    <Stepper Grid.Row="0" Grid.Column="2" 
                             x:Name="stp_adultos"
                             Minimum="1"
                             Maximum="10"
                             Increment="1"/>

                    <Label Grid.Row="1" Grid.Column="0" 
                           Text="Crianças: "/>
                    <Stepper Grid.Row="1" Grid.Column="2" 
                             x:Name="stp_criancas"
                             Minimum="1"
                             Maximum="10"
                             Increment="1"/>

                </Grid>


                <Border>
                    <VerticalStackLayout>
                        <Label Text="ESCOLHA SUA SUÍTE"/>

                        <Picker x:Name="pck_quarto" Title="Selecione Sua acomodação" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="10">
                    <VerticalStackLayout>
                        <Label Text="PERIODO DE ESTADIA"/>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">                            
                         
                                <Label Text="Check-in: " />
                                <DatePicker x:Name="dtpck_chekin"
                                                Format="dd/MM/yyyy"
                                            Grid.Row="0" Grid.Column="1"/>
             
                                <Label Text="Check-out: " Grid.Row="1" Grid.Column="0"/>
                                <DatePicker x:Name="dtpck_chekout"
                                                Format="dd/MM/yyy"
                                            Grid.Row="1" Grid.Column="1"/>                        
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Button Text="Avançar" Margin="6" Padding="10" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>