<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray200}">
    
    <VerticalStackLayout VerticalOptions="Center" 
                         HorizontalOptions="Center" Padding="10">

        <HorizontalStackLayout>
            <Label 
            Text="SOBRE"
            FontFamily="CookieRegular" 
            FontSize="Large"
            Padding="16"/>


            <!-- Fonte da imagem : https://www.magnific.com/free-vector/hand-drawn-friends-cartoon-illustration_45199925.htm -->
            <Image Source="twinbrothers.jpg" HorizontalOptions="End" Visual="Default" HeightRequest="100" WidthRequest="100"/>
        </HorizontalStackLayout>

        <Label
            Text="O Hotel Dois Irmãos Foi fundado em 1980 por João e José da Familia Silva na cidade de Tagamandapio, visamos atender desde o cliente mais exigente até aquele que não dispõe de maiores condições financeiras"
          FontFamily="CookieRegular" 
          FontSize="Medium"
            
          LineBreakMode="WordWrap"
          MaximumWidthRequest="400"/>

        <HorizontalStackLayout Padding="16">
            <Label 
            Text="Desenvolvido por: Jhonatan Alves Fonseca"
             FontFamily="CookieRegular"
             FontSize="Small"
             FontAttributes="Italic"/>

                <Label 
            Text=" Versão 0.0.1b "
             FontFamily="CookieRegular" 
             FontSize="Small"
             FontAttributes="Italic"/>

                <Label 
            Text=" © 2026"
             FontFamily="CookieRegular" 
             FontSize="Small"
             FontAttributes="Italic"/>
        </HorizontalStackLayout>

                <Button Text="Voltar" x:Name="btn_voltar" Clicked="btn_voltar_Clicked" 
                        Margin="6" Padding="10"
                        BackgroundColor="{StaticResource Tertiary}" HorizontalOptions="Start"/>
    </VerticalStackLayout>


</ContentPage>