<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray200}">
    <VerticalStackLayout VerticalOptions="Center" 
                         HorizontalOptions="Center" Padding="10">

        <Label Text="{Binding QuartoSelecionado.Descricao}" TextColor="{StaticResource Black}"
               FontFamily="CookieRegular"
               FontSize="50"
               HorizontalTextAlignment="Center"/>

        <Border Margin="10" Padding="10">
            <HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Adultos: " Padding="4"/>
                    <Label Text="{Binding QtdAdultos}" TextColor="{StaticResource PrimaryDarkText}" Padding="4"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Crianças: " Padding="4"/>
                    <Label Text="{Binding QtdCriancas}" TextColor="{StaticResource SecondaryDarkText}" Padding="4"/>
                </HorizontalStackLayout>
                
            </HorizontalStackLayout>
        </Border>

        <Border>
            <Grid ColumnDefinitions="auto, auto , auto" RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text=" Data de Check-in: " Padding="4"/>
                <Label Grid.Row="0" Grid.Column="1" Text=" Data de Check-out: " Padding="4" TextColor="{StaticResource PrimaryDarkText}"/>
                <Label Grid.Row="0" Grid.Column="2" Text=" Estadia: " Padding="4" TextColor="{StaticResource Tertiary}"/>

                <Label Grid.Row="1" Grid.Column="0" Padding="4" Text="{Binding DataCheckin, StringFormat='{0:dd/MM/yyyy}'}"/>
                <Label Grid.Row="1" Grid.Column="1" Padding="4" Text="{Binding DataCheckout, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{StaticResource PrimaryDarkText}"/>
                <Label Grid.Row="1" Grid.Column="2" Padding="4" Text="{Binding Estadia}" TextColor="{StaticResource Tertiary}"/>
            </Grid>
        </Border>

        <Border>
            <HorizontalStackLayout>
                <Label Text="Valor Total R$ "/>

                <Label Text="{Binding ValorTotal, StringFormat='{0:F2}'}" TextColor="{StaticResource PrimaryDarkText}"/>
            </HorizontalStackLayout>

        </Border>

        <Border>
            <HorizontalStackLayout>
                <Button x:Name="btn_voltar" Clicked="btn_voltar_Clicked" Text="Voltar"
                        HorizontalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>