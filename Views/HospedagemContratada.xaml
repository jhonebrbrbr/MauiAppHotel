<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray200}">
    <VerticalStackLayout VerticalOptions="Center" 
                         HorizontalOptions="Center" Padding="10">

        <Label Text="" TextColor="{StaticResource Black}"
               FontFamily="CookieRegular"
               FontSize="50"
               HorizontalTextAlignment="Center"/>

        <Border Margin="10" Padding="10">
            <HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Adultos: "/>
                    <Label Text="" TextColor="{StaticResource PrimaryDarkText}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Crianças: "/>
                    <Label Text="" TextColor="{StaticResource SecondaryDarkText}"/>
                </HorizontalStackLayout>
                
            </HorizontalStackLayout>
        </Border>

        <Border>
            <Grid ColumnDefinitions="*, * , *" RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Data de Check-in: "/>
                <Label Grid.Row="0" Grid.Column="1" Text="Data de Check-out: " TextColor="{StaticResource PrimaryDarkText}"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: " TextColor="{StaticResource Tertiary}"/>

                <Label Grid.Row="1" Grid.Column="0" Text=""/>
                <Label Grid.Row="1" Grid.Column="1" Text="" TextColor="{StaticResource PrimaryDarkText}"/>
                <Label Grid.Row="1" Grid.Column="2" Text="" TextColor="{StaticResource Tertiary}"/>
            </Grid>
        </Border>

        <Border>
            <HorizontalStackLayout>
                <Label Text="Valor Total R$ "/>

                <Label Text="" TextColor="{StaticResource PrimaryDarkText}"/>
            </HorizontalStackLayout>

        </Border>

        <Border>
            <HorizontalStackLayout>
                <Button x:Name="btn_voltar" Clicked="btn_voltar_Clicked" Text="Voltar"
                        HorizontalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>